{
  "name": "sandbox-app-template",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": { "node": ">=22.12.0" },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "postcss": "8.5.28",
    "js-yaml": "4.3.2",
    "esbuild": "0.28.2",
    "uuid": "11.1.1",
    "image-size": "2.0.4",
    "decode-uri-component": "0.5.0"
  },
  "scripts": {
    "dev": "cd packages/web && bunx vite",
    "dev:desktop": "cd packages/desktop && bunx vite",
    "dev:mobile": "cd packages/mobile && bunx expo start --port $(bun --print \"require('../../__ports.cjs').mobile\")",
    "build": "turbo build",
    "build:web": "cd packages/web && bunx vite build",
    "start": "pm2 startOrRestart ecosystem.config.cjs --update-env",
    "stop": "pm2 delete web-app 2>/dev/null || true",
    "kill:port": "bun run internal:kill-port",
    "lint": "oxlint packages/web/src",
    "lint:fix": "oxlint packages/web/src --fix",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "internal:kill-port": "lsof -t -i :$(bun --print \"require('./__ports.cjs').website\") | xargs kill -9"
  },
  "devDependencies": {
    "@tursodatabase/api": "^1.9.2",
    "@types/bun": "1.3.14",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "turbo": "2.9.18",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@libsql/client": "^0.17.4",
    "cloudflare": "^5.2.0",
    "pm2": "^7.0.4"
  },
  "patchedDependencies": {
    "metro@0.83.3": "patches/metro@0.83.3.patch",
    "query-string@7.1.3": "patches/query-string@7.1.3.patch"
  }
}
