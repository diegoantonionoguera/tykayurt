{
  "name": "@template/web",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/api/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --ssr src/web/entry-server.tsx --outDir dist-ssr && node tools/prerender.mjs",
    "dev": "vite",
    "start": "bun src/__server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium --project=mobile-chromium",
    "check": "npm run typecheck && npm run test && npm run build",
    "typecheck": "tsc --noEmit",
    "preview": "bun run build && vite preview",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env drizzle-kit push"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@orpc/client": "^1.15.3",
    "@orpc/server": "^1.15.3",
    "@orpc/tanstack-query": "^1.15.3",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "lucide-react": "^0.577.0",
    "motion": "^13.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.88.0",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.7.0",
    "wouter": "^3.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "latest",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.8",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.1.4",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
